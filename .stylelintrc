{
  "plugins": ["stylelint-order", "@stylistic/stylelint-plugin"],
  "rules": {
    "@stylistic/indentation": 2,
    "@stylistic/declaration-colon-space-after": "always",
    "@stylistic/declaration-colon-space-before": "never",
    "@stylistic/block-opening-brace-space-before": "always",
    "max-nesting-depth": 4,
    "selector-max-compound-selectors": 3,
    "selector-no-qualifying-type": true,
    "no-duplicate-selectors": true,
    "block-no-empty": true,
    "at-rule-empty-line-before": [
      "always",
      {
        "except": ["after-same-name", "first-nested"]
      }
    ],
    "@stylistic/at-rule-name-case": "lower",
    "@stylistic/color-hex-case": "upper",
    "color-hex-length": "long",
    "color-no-invalid-hex": true,
    "@stylistic/string-quotes": "single",
    "@stylistic/value-list-comma-space-after": "always-single-line",
    "comment-whitespace-inside": "always",
    "length-zero-no-unit": true,
    "@stylistic/number-no-trailing-zeros": true,
    "@stylistic/declaration-block-trailing-semicolon": "always",
    "declaration-block-no-duplicate-properties": true,
    "@stylistic/declaration-block-semicolon-newline-after": "always-multi-line",
    "@stylistic/block-closing-brace-empty-line-before": "never",
    "@stylistic/block-closing-brace-newline-before": "always",
    "order/order": ["custom-properties", "dollar-variables", "declarations", "at-rules"],
    "order/properties-order": [
      "display",
      "list-style",
      "position",
      "top",
      "left",
      "bottom",
      "right",
      "float",
      "clear",
      "width",
      "height",
      "padding",
      "margin",
      "flex-direction",
      "justify-content",
      "align-items",
      "border",
      "background",
      "color",
      "font",
      "text-decoration",
      "text-align",
      "vertical-align",
      "white-space",
      "content"
    ],
    "@stylistic/declaration-block-single-line-max-declarations": 1
  },
  "overrides": [
    {
      "files": ["**/*.vue", "**/*.html"],
      "customSyntax": "postcss-html",
      "rules": {
        "@stylistic/indentation": null,
        "@stylistic/scss/indentation": 2,
        "@stylistic/declaration-colon-space-after": null,
        "@stylistic/scss/declaration-colon-space-after": "always",
        "@stylistic/declaration-colon-space-before": null,
        "@stylistic/scss/declaration-colon-space-before": "never",
        "@stylistic/block-opening-brace-space-before": null,
        "@stylistic/scss/block-opening-brace-space-before": "always",
        "@stylistic/at-rule-name-case": null,
        "@stylistic/scss/at-rule-name-case": "lower",
        "@stylistic/color-hex-case": null,
        "@stylistic/scss/color-hex-case": "upper",
        "@stylistic/string-quotes": null,
        "@stylistic/scss/string-quotes": "single",
        "@stylistic/value-list-comma-space-after": null,
        "@stylistic/scss/value-list-comma-space-after": "always-single-line",
        "@stylistic/number-no-trailing-zeros": null,
        "@stylistic/scss/number-no-trailing-zeros": true,
        "@stylistic/declaration-block-trailing-semicolon": null,
        "@stylistic/scss/declaration-block-trailing-semicolon": "always",
        "@stylistic/declaration-block-semicolon-newline-after": null,
        "@stylistic/scss/declaration-block-semicolon-newline-after": "always-multi-line",
        "@stylistic/block-closing-brace-empty-line-before": null,
        "@stylistic/scss/block-closing-brace-empty-line-before": "never",
        "@stylistic/block-closing-brace-newline-before": null,
        "@stylistic/scss/block-closing-brace-newline-before": "always",
        "@stylistic/declaration-block-single-line-max-declarations": null,
        "@stylistic/scss/declaration-block-single-line-max-declarations": 1
      }
    },
    {
      "files": ["**/*.scss"],
      "customSyntax": "postcss-scss",
      "rules": {
        "@stylistic/indentation": null,
        "@stylistic/scss/indentation": 2,
        "@stylistic/declaration-colon-space-after": null,
        "@stylistic/scss/declaration-colon-space-after": "always",
        "@stylistic/declaration-colon-space-before": null,
        "@stylistic/scss/declaration-colon-space-before": "never",
        "@stylistic/block-opening-brace-space-before": null,
        "@stylistic/scss/block-opening-brace-space-before": "always",
        "@stylistic/at-rule-name-case": null,
        "@stylistic/scss/at-rule-name-case": "lower",
        "@stylistic/color-hex-case": null,
        "@stylistic/scss/color-hex-case": "upper",
        "@stylistic/string-quotes": null,
        "@stylistic/scss/string-quotes": "single",
        "@stylistic/value-list-comma-space-after": null,
        "@stylistic/scss/value-list-comma-space-after": "always-single-line",
        "@stylistic/number-no-trailing-zeros": null,
        "@stylistic/scss/number-no-trailing-zeros": true,
        "@stylistic/declaration-block-trailing-semicolon": null,
        "@stylistic/scss/declaration-block-trailing-semicolon": "always",
        "@stylistic/declaration-block-semicolon-newline-after": null,
        "@stylistic/scss/declaration-block-semicolon-newline-after": "always-multi-line",
        "@stylistic/block-closing-brace-empty-line-before": null,
        "@stylistic/scss/block-closing-brace-empty-line-before": "never",
        "@stylistic/block-closing-brace-newline-before": null,
        "@stylistic/scss/block-closing-brace-newline-before": "always",
        "@stylistic/declaration-block-single-line-max-declarations": null,
        "@stylistic/scss/declaration-block-single-line-max-declarations": 1
      }
    }
  ]
}
