{
  "name": "exem-evui-library",
  "description": "A EXEM Library project",
  "author": "exem <dev_client@ex-em.com>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15.0",
    "pnpm": ">=10.34.9 <11"
  },
  "devDependencies": {
    "@evui/eslint-config": "workspace:*",
    "@evui/stylelint-config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "nx": "^24.0.6",
    "prettier": "^3.10.1",
    "stylelint": "^18.0.0",
    "eslint": "^10.15.0",
    "typescript": "~5.9.3",
    "vue": "^3.5.45"
  },
  "scripts": {
    "build": "nx run-many --target=build --all --parallel",
    "types-check": "nx run-many --target=type-check --all",
    "storybook": "nx storybook docs",
    "prettier": "nx run-many --target=prettier --all",
    "lint": "nx run-many --target=lint --all",
    "lint:style": "nx run-many --target=lint:style --all",
    "graph": "nx graph",
    "reset": "nx reset",
    "prepare": "husky",
    "audit": "pnpm audit --audit-level=low"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "nx",
      "vue-demi"
    ],
    "overrides": {
      "nx>minimatch": "^11.0.9",
      "@microsoft/api-extractor>minimatch": "^11.0.9"
    }
  }
}
