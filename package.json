{
  "name": "evui",
  "version": "3.24.0",
  "description": "A EXEM Library project",
  "author": "exem <dev_client@ex-em.com>",
  "license": "MIT",
  "type": "module",
  "homepage": ".",
  "scripts": {
    "lint": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{js,vue,scss,css,json}\" \"docs/**/*.{js,vue,scss,css,json}\" \"*.{js,cjs,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,scss,css,json}\" \"docs/**/*.{js,vue,scss,css,json}\" \"*.{js,cjs,json,md}\"",
    "docs": "vite serve --config vite.config.js --port 9999 --host",
    "dev_docs": "vite serve --config vite.config.js --port 9999 --host --mode internal",
    "docs:validate": "node scripts/validate-api-docs.js",
    "build:lib": "vite build --config vite.config.lib.js && rimraf ./dist/demo.html",
    "build:docs": "vite build --config vite.config.js --mode production",
    "preview": "vite preview --port 9999",
    "prepare": "husky",
    "test": "node --no-experimental-webstorage node_modules/vitest/vitest.mjs",
    "test:run": "node --no-experimental-webstorage node_modules/vitest/vitest.mjs run",
    "test:coverage": "node --no-experimental-webstorage node_modules/vitest/vitest.mjs run --coverage",
    "test:visual": "vitest --config vitest.config.browser.js",
    "test:visual:update": "vitest --config vitest.config.browser.js --update",
    "audit": "node .github/scripts/audit-dependencies.cjs"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./style": {
      "import": "./dist/style.css",
      "require": "./dist/style.css"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "bignumber.js": "^9.3.1",
    "dayjs": "^1.11.23",
    "korean-regexp": "^1.0.13",
    "lodash-es": "^4.18.1",
    "vue": "^3.5.45",
    "vue3-observe-visibility": "^1.0.7"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.6",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/compiler-sfc": "^3.5.45",
    "@vue/test-utils": "^2.6.0",
    "codemirror": "^6.0.2",
    "eslint": "^9.39.5",
    "eslint-config-exem": "^3.1.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.12.1",
    "gh-pages": "^6.3.0",
    "highlight.js": "^11.12.0",
    "husky": "^9.1.7",
    "jsdom": "~31.0.1",
    "lint-staged": "^17.6.1",
    "lodash-es": "^4.18.1",
    "marked": "^18.2.1",
    "marked-gfm-heading-id": "^4.1.4",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "semantic-release": "^25.0.9",
    "stylelint": "^18.0.0",
    "stylelint-order": "^8.1.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "vitest-browser-vue": "^2.1.0",
    "vue-router": "^5.5.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@stylistic/stylelint-plugin": "^6.0.1",
    "postcss-html": "^2.0.1",
    "postcss-scss": "^4.0.9",
    "rimraf": "^6.1.4",
    "vue-eslint-parser": "^10.4.2"
  },
  "peerDependencies": {
    "vue": "^3.5.8"
  },
  "lint-staged": {
    "*.{js,vue}": "eslint --fix",
    "docs/views/apiDocs/data/*.json": "node scripts/validate-api-docs.js"
  },
  "packageManager": "npm@11.19.1",
  "overrides": {
    "glob@>=9 <14.0.2": "^14.0.6",
    "minimatch@>=7 <11.0.1": "^11.0.9",
    "eslint-config-exem": {
      "eslint": "$eslint"
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.22.2 || ^24.15.0 || >=26.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.1 <12",
      "onFail": "error"
    }
  }
}
