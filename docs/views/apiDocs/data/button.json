{
  "component": "EvButton",
  "route": "/button",
  "since": "3.0.0",
  "description": "클릭 동작을 수행하는 기본 버튼 컴포넌트입니다.",
  "examples": [
    {
      "label": "기본 버튼",
      "route": "/button"
    }
  ],
  "sections": [
    {
      "kind": "props",
      "label": "Props",
      "items": [
        {
          "name": "type",
          "type": "String",
          "default": "'default'",
          "values": [
            "'default'",
            "'primary'",
            "'info'",
            "'warning'",
            "'error'",
            "'ghost'"
          ],
          "description": "버튼의 색상 타입입니다."
        },
        {
          "name": "size",
          "type": "String",
          "default": "'medium'",
          "values": [
            "'small'",
            "'medium'",
            "'large'"
          ],
          "description": "버튼의 크기입니다."
        },
        {
          "name": "shape",
          "type": "String",
          "default": "'square'",
          "values": [
            "'square'",
            "'radius'",
            "'circle'"
          ],
          "description": "버튼의 모양입니다."
        },
        {
          "name": "disabled",
          "type": "Boolean",
          "default": "false",
          "description": "버튼 비활성화 여부입니다."
        },
        {
          "name": "autofocus",
          "type": "Boolean",
          "default": "false",
          "description": "마운트 시 자동 포커스 여부입니다."
        },
        {
          "name": "htmlType",
          "type": "String",
          "default": "'button'",
          "values": [
            "'button'",
            "'submit'",
            "'reset'"
          ],
          "description": "네이티브 button 요소의 type 속성입니다."
        }
      ]
    },
    {
      "kind": "events",
      "label": "Events",
      "items": [
        {
          "name": "click",
          "type": "Function",
          "description": "버튼 클릭 시 발생합니다. 네이티브 MouseEvent를 전달합니다."
        }
      ]
    },
    {
      "kind": "slots",
      "label": "Slots",
      "items": [
        {
          "name": "default",
          "description": "버튼 내부에 표시할 콘텐츠(텍스트, 아이콘 등)입니다."
        }
      ]
    }
  ]
}
