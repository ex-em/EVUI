{
  "component": "EvChart (Pie)",
  "route": "/pieChart",
  "since": "3.0.0",
  "description": "Canvas 기반 파이 차트 컴포넌트입니다. 도넛 홀, 범례, 툴팁, 조각 위 값 표시 등을 지원합니다.",
  "examples": [
    {
      "label": "PieChart",
      "route": "/pieChart"
    }
  ],
  "playground": {
    "route": "/pieChart",
    "example": "Doughnut"
  },
  "sections": [
    {
      "kind": "props",
      "label": "Props",
      "items": [
        {
          "name": "v-model:selectedItem",
          "type": "Object",
          "description": "options의 selectItem 옵션을 사용할 경우 유효한 바인딩으로, 현재 선택된 아이템 정보(seriesID)를 담습니다.",
          "tryIt": false
        },
        {
          "name": "v-model:legend-data",
          "type": "Array",
          "description": "legend.external이 true일 때 유효한 바인딩으로, 차트 갱신 시 { sId, name, color, type, show } 형태의 범례 아이템 배열로 갱신되어 외부에서 범례를 렌더링할 수 있습니다. 외부 범례에서 클릭/호버 시 ref로 노출되는 toggleSeries(sId), highlightSeries(sId), unhighlightSeries() 메서드를 사용합니다.",
          "tryIt": false
        },
        {
          "name": "data",
          "type": "Object",
          "required": true,
          "description": "차트에 표현할 시리즈와 데이터 정보입니다.",
          "children": [
            {
              "name": "series",
              "type": "Object",
              "default": "{}",
              "description": "특정 데이터에 대한 시리즈 옵션입니다. key가 시리즈 ID로 사용됩니다.",
              "children": [
                {
                  "name": "show",
                  "type": "Boolean",
                  "default": "true",
                  "description": "시리즈 표시 여부입니다."
                },
                {
                  "name": "name",
                  "type": "String",
                  "default": "series-${index}",
                  "description": "시리즈의 이름입니다."
                },
                {
                  "name": "type",
                  "type": "String",
                  "values": [
                    "'pie'",
                    "'bar'",
                    "'line'",
                    "'scatter'"
                  ],
                  "description": "시리즈에 해당하는 데이터 표현 방식입니다. 미지정 시 options.type을 따릅니다."
                },
                {
                  "name": "color",
                  "type": "Hex, RGB, RGBA Code(String)",
                  "default": "COLOR[index]",
                  "description": "시리즈 색상입니다. 사전에 정의된 25개 색상('#2b99f0' ~ '#df6264')을 순차적으로 적용합니다."
                },
                {
                  "name": "showLegend",
                  "type": "Boolean",
                  "default": "true",
                  "description": "범례에 시리즈를 표시할지 여부입니다."
                },
                {
                  "name": "showValue",
                  "type": "Object",
                  "description": "조각 위에 값 표시 여부 및 속성입니다.",
                  "children": [
                    {
                      "name": "use",
                      "type": "Boolean",
                      "default": "false",
                      "description": "data label 표시 여부입니다."
                    },
                    {
                      "name": "textColor",
                      "type": "Hex, RGB, RGBA Code(String)",
                      "default": "'#000000'",
                      "description": "글자 색상입니다."
                    },
                    {
                      "name": "fontSize",
                      "type": "Number",
                      "default": "12",
                      "description": "글자 크기입니다."
                    },
                    {
                      "name": "formatter",
                      "type": "function",
                      "default": "null",
                      "description": "데이터가 표시되기 전에 데이터의 형식을 지정하는 데 사용합니다. 예: ({ value, percentage }) => percentage + '%' + '(' + value + ')'"
                    }
                  ],
                  "tryIt": {
                    "data": "{ series: { series1: { showValue: { use: true } }, series2: { showValue: { use: true } }, series3: { showValue: { use: true } } } }"
                  }
                }
              ]
            },
            {
              "name": "data",
              "type": "Object",
              "default": "{}",
              "description": "차트에 표시할 시리즈별 데이터입니다."
            }
          ]
        },
        {
          "name": "options",
          "type": "Object",
          "description": "차트의 표현 방식을 정의하는 옵션 집합입니다.",
          "children": [
            {
              "name": "type",
              "type": "String",
              "default": "''",
              "values": [
                "'bar'",
                "'pie'",
                "'line'",
                "'scatter'"
              ],
              "description": "series별로 type 값을 지정하지 않을 경우 일괄 적용될 차트의 타입입니다."
            },
            {
              "name": "width",
              "type": "String / Number",
              "default": "'100%'",
              "description": "차트의 너비입니다. 예: '100%', '150px', 150"
            },
            {
              "name": "height",
              "type": "String / Number",
              "default": "'100%'",
              "description": "차트의 높이입니다. 예: '100%', '150px', 150"
            },
            {
              "name": "padding",
              "type": "Object",
              "default": "{ top: 2, right: 2, left: 2, bottom: 4 }",
              "description": "차트 영역의 안쪽 여백입니다. 파이 반지름 계산에 사용되며, pie 타입에서 미지정 시 위 기본값이 적용됩니다."
            },
            {
              "name": "unSelectedOpacity",
              "type": "Number",
              "default": "0.3",
              "description": "범례 hover 등으로 특정 시리즈 강조 시 나머지 조각에 적용되는 투명도입니다."
            },
            {
              "name": "title",
              "type": "Object",
              "description": "차트 상단에 위치할 차트 제목의 표시 여부 및 속성입니다.",
              "children": [
                {
                  "name": "show",
                  "type": "Boolean",
                  "default": "false",
                  "description": "타이틀 표시 여부입니다."
                },
                {
                  "name": "height",
                  "type": "Number",
                  "default": "40",
                  "description": "타이틀 영역의 높이입니다."
                },
                {
                  "name": "text",
                  "type": "String",
                  "default": "''",
                  "description": "타이틀 문자열입니다."
                },
                {
                  "name": "style",
                  "type": "Object",
                  "description": "타이틀 폰트 스타일입니다.",
                  "children": [
                    {
                      "name": "fontSize",
                      "type": "Number",
                      "default": "15",
                      "description": "글자 크기입니다."
                    },
                    {
                      "name": "color",
                      "type": "Hex, RGB, RGBA Code(String)",
                      "default": "'#000'",
                      "description": "글자 색상입니다."
                    },
                    {
                      "name": "fontFamily",
                      "type": "String",
                      "default": "'Roboto'",
                      "description": "글자체입니다."
                    }
                  ]
                }
              ]
            },
            {
              "name": "legend",
              "type": "Object",
              "description": "차트 범례의 표시 여부 및 속성입니다.",
              "children": [
                {
                  "name": "show",
                  "type": "Boolean",
                  "default": "true",
                  "description": "Legend 표시 여부입니다."
                },
                {
                  "name": "position",
                  "type": "String",
                  "default": "'right'",
                  "values": [
                    "'top'",
                    "'right'",
                    "'bottom'",
                    "'left'"
                  ],
                  "description": "Legend 위치입니다.",
                  "tryIt": {
                    "options": "{ legend: { show: true, position: 'bottom' } }"
                  }
                },
                {
                  "name": "color",
                  "type": "Hex, RGB, RGBA Code(String)",
                  "default": "'#353740'",
                  "description": "폰트 색상입니다."
                },
                {
                  "name": "inactive",
                  "type": "Hex, RGB, RGBA Code(String)",
                  "default": "'#aaa'",
                  "description": "비활성화 상태의 폰트 색상입니다."
                },
                {
                  "name": "width",
                  "type": "Number",
                  "default": "140",
                  "description": "Legend의 넓이입니다('left', 'right' 위치일 때 조절)."
                },
                {
                  "name": "height",
                  "type": "Number",
                  "default": "24",
                  "description": "Legend의 높이입니다('top', 'bottom' 위치일 때 조절)."
                },
                {
                  "name": "padding",
                  "type": "Object",
                  "default": "{ top: 0, right: 0, left: 0, bottom: 0 }",
                  "description": "Legend 내부 padding 값입니다."
                },
                {
                  "name": "allowResize",
                  "type": "Boolean",
                  "default": "false",
                  "description": "Legend 영역 리사이즈 가능 여부입니다."
                },
                {
                  "name": "table",
                  "type": "Object",
                  "description": "값 표시를 포함하는 Table 타입 Legend입니다. bar, line, pie 전용입니다.",
                  "children": [
                    {
                      "name": "use",
                      "type": "Boolean",
                      "default": "false",
                      "description": "Table 타입 표시 여부입니다."
                    },
                    {
                      "name": "style",
                      "type": "Object",
                      "default": "null",
                      "description": "table 스타일입니다. 예: { row: {}, header: {} }",
                      "children": [
                        {
                          "name": "row",
                          "type": "Object",
                          "default": "null",
                          "description": "table row의 CSS 스타일입니다. 예: { borderBottom: '1px solid #DBDBDB' }"
                        },
                        {
                          "name": "header",
                          "type": "Object",
                          "default": "null",
                          "description": "table header의 CSS 스타일입니다. 예: { fontSize: '15px' }"
                        }
                      ]
                    },
                    {
                      "name": "columns",
                      "type": "Object",
                      "description": "Table에 표시할 칼럼별 옵션입니다.",
                      "children": [
                        {
                          "name": "name",
                          "type": "Object",
                          "default": "{ title: 'Name' }",
                          "description": "Series Name 표시 관련 옵션입니다. 예: { title: '시리즈명', style: {...} }"
                        },
                        {
                          "name": "min",
                          "type": "Object",
                          "default": "{ use: false, title: 'MIN' }",
                          "description": "Minimum Value 표시 관련 옵션입니다. 예: { use: true, title: '최솟값', style: {...}, formatter: (v) => `${v.toFixed(2)}` }"
                        },
                        {
                          "name": "max",
                          "type": "Object",
                          "default": "{ use: false, title: 'MAX' }",
                          "description": "Maximum Value 표시 관련 옵션입니다. 예: { use: true, title: '최댓값', style: {...}, decimalPoint: 2 }"
                        },
                        {
                          "name": "avg",
                          "type": "Object",
                          "default": "{ use: false, title: 'AVG' }",
                          "description": "Average Value 표시 관련 옵션입니다. 예: { use: true, title: '평균', style: {...}, decimalPoint: 2 }"
                        },
                        {
                          "name": "total",
                          "type": "Object",
                          "default": "{ use: false, title: 'TOTAL' }",
                          "description": "Total Value 표시 관련 옵션입니다. 예: { use: true, title: '합계', style: {...}, decimalPoint: 2 }"
                        },
                        {
                          "name": "last",
                          "type": "Object",
                          "default": "{ use: false, title: 'LAST' }",
                          "description": "Last Value 표시 관련 옵션입니다. 예: { use: true, title: 'Current', style: {...}, decimalPoint: 2 }"
                        }
                      ]
                    }
                  ]
                },
                {
                  "name": "stopClickEvt",
                  "type": "Boolean",
                  "default": "false",
                  "description": "Legend 클릭 이벤트를 중지할지 여부입니다."
                },
                {
                  "name": "virtualScroll",
                  "type": "Boolean",
                  "default": "false",
                  "description": "Legend에 가상 스크롤 적용 여부입니다."
                },
                {
                  "name": "clickMode",
                  "type": "'active' | 'inactive'",
                  "default": "'active'",
                  "values": [
                    "'active'",
                    "'inactive'"
                  ],
                  "description": "Legend 클릭 시 활성화 여부입니다."
                },
                {
                  "name": "external",
                  "type": "Boolean",
                  "default": "false",
                  "description": "범례를 차트 외부에서 렌더링할지 여부입니다. true이면 차트 내부에 범례를 그리지 않고 v-model:legend-data로 전달된 배열을 외부에서 렌더링할 수 있으며, ref로 toggleSeries(sId), highlightSeries(sId), unhighlightSeries()를 사용할 수 있습니다."
                }
              ]
            },
            {
              "name": "doughnutHoleSize",
              "type": "Number",
              "default": "0",
              "description": "내부 hole 사이즈입니다(0 ~ 1).",
              "tryIt": {
                "options": "{ doughnutHoleSize: 0.7 }"
              }
            },
            {
              "name": "pieStroke",
              "type": "Object",
              "default": "{ use: true, color: '#FFFFFF', lineWidth: 2 }",
              "description": "조각 테두리선 표시 여부 및 색상, 두께를 설정하는 옵션입니다.",
              "children": [
                {
                  "name": "use",
                  "type": "Boolean",
                  "default": "true",
                  "description": "테두리선 표시 여부입니다."
                },
                {
                  "name": "color",
                  "type": "Hex, RGB, RGBA Code(String)",
                  "default": "'#FFFFFF'",
                  "description": "테두리선 색상입니다."
                },
                {
                  "name": "lineWidth",
                  "type": "Number",
                  "default": "2",
                  "description": "테두리선 두께입니다."
                }
              ]
            },
            {
              "name": "sunburst",
              "type": "Boolean",
              "description": "다계층(선버스트) 파이 차트 모드입니다. true이면 data.data를 { id, value, children } 객체의 배열로 전달하며, children 배열로 하위 계층을 중첩합니다. 미지정 시 일반 파이로 렌더링됩니다."
            },
            {
              "name": "reverse",
              "type": "Boolean",
              "default": "false",
              "description": "sunburst 모드에서 계층 렌더링 순서를 반전할지 여부입니다."
            },
            {
              "name": "tooltip",
              "type": "Object",
              "description": "차트에 마우스를 올릴 경우 표시되는 툴팁의 표시 여부 및 속성입니다.",
              "children": [
                {
                  "name": "use",
                  "type": "Boolean",
                  "default": "true",
                  "description": "tooltip 표시 여부입니다."
                },
                {
                  "name": "backgroundColor",
                  "type": "Hex, RGB, RGBA Code(String)",
                  "default": "'#4C4C4C'",
                  "description": "tooltip 배경 색상입니다."
                },
                {
                  "name": "borderColor",
                  "type": "Hex, RGB, RGBA Code(String)",
                  "default": "'#666666'",
                  "description": "tooltip 테두리 색상입니다."
                },
                {
                  "name": "useShadow",
                  "type": "Boolean",
                  "default": "false",
                  "description": "그림자 사용 여부입니다."
                },
                {
                  "name": "shadowOpacity",
                  "type": "Number",
                  "default": "0.25",
                  "description": "그림자 투명도입니다."
                },
                {
                  "name": "throttledMove",
                  "type": "Boolean",
                  "default": "true",
                  "description": "데이터 조회 시 Throttling 처리 유무입니다."
                },
                {
                  "name": "debouncedHide",
                  "type": "Boolean",
                  "default": "false",
                  "description": "좌표 이동 시 tooltip을 숨길지 여부입니다."
                },
                {
                  "name": "sortByValue",
                  "type": "Boolean",
                  "default": "true",
                  "description": "값을 기준으로 정렬할지 여부입니다."
                },
                {
                  "name": "useScrollbar",
                  "type": "Boolean",
                  "default": "false",
                  "description": "스크롤바 사용 여부입니다."
                },
                {
                  "name": "htmlScrollTarget",
                  "type": "String",
                  "description": "formatter.html 커스텀 툴팁에서 휠 스크롤을 전달할 내부 요소의 CSS 셀렉터입니다. 가상 스크롤 활성 시에는 자동 처리되어 불필요합니다. 예: '.ev-chart-tooltip-custom__body'"
                },
                {
                  "name": "maxHeight",
                  "type": "Number",
                  "description": "툴팁의 최대 높이입니다."
                },
                {
                  "name": "maxWidth",
                  "type": "Number",
                  "description": "툴팁의 최대 너비입니다."
                },
                {
                  "name": "textOverflow",
                  "type": "String",
                  "default": "'wrap'",
                  "values": [
                    "'wrap'",
                    "'ellipsis'"
                  ],
                  "description": "툴팁에 표시될 텍스트가 maxWidth 값을 넘길 경우의 처리 방식입니다."
                },
                {
                  "name": "fontFamily",
                  "type": "String",
                  "default": "'Roboto'",
                  "description": "툴팁에 표시될 폰트입니다. 예: 'Roboto', 'serif'"
                },
                {
                  "name": "fontColor",
                  "type": "Hex code (string), Object",
                  "default": "'#FFFFFF'",
                  "description": "툴팁에 표시될 폰트 컬러입니다. { label, value, title } 형태로 영역별 지정도 가능합니다."
                },
                {
                  "name": "fontSize",
                  "type": "Object",
                  "default": "{ title: 16, contents: 14 }",
                  "description": "툴팁에 표시될 폰트 사이즈입니다."
                },
                {
                  "name": "colorShape",
                  "type": "String",
                  "default": "'rect'",
                  "values": [
                    "'rect'",
                    "'circle'"
                  ],
                  "description": "툴팁에 표시될 series color의 모양입니다."
                },
                {
                  "name": "rowPadding",
                  "type": "Object",
                  "default": "{ top: 0, bottom: 3, right: 20, left: 16 }",
                  "description": "툴팁에 표시될 series Row의 padding 값입니다."
                },
                {
                  "name": "showHeader",
                  "type": "Boolean",
                  "default": "true",
                  "description": "툴팁의 Header 영역 표시 여부입니다."
                },
                {
                  "name": "formatter",
                  "type": "function / Object",
                  "default": "null",
                  "description": "데이터가 표시되기 전에 형식을 지정합니다. 함수형(({ name, value, percentage, seriesId }) => string), { title, value } 객체형(value: ({ name, value, percentage, seriesId }) => string), { html } 커스텀 HTML형 3가지 형태를 지원합니다."
                },
                {
                  "name": "returnValue",
                  "type": "function",
                  "default": "null",
                  "description": "외부 컴포넌트로 커스텀 툴팁을 구현할 때 사용하는 함수입니다. (seriesList, event) 인자를 받습니다.",
                  "children": [
                    {
                      "name": "seriesList",
                      "type": "Array<SeriesItem>",
                      "description": "마우스 위치에 해당하는 시리즈 데이터 배열입니다.",
                      "children": [
                        {
                          "name": "sId",
                          "type": "String",
                          "description": "시리즈 ID입니다. 예: 'series1'"
                        },
                        {
                          "name": "data",
                          "type": "Object",
                          "description": "시리즈 데이터입니다. 예: { x: Date, y: Number, xp: Number, yp: Number, o: Number }"
                        },
                        {
                          "name": "color",
                          "type": "String",
                          "description": "시리즈 색상입니다. 예: '#2b99f0'"
                        },
                        {
                          "name": "name",
                          "type": "String",
                          "description": "시리즈 이름입니다. 예: 'Series 1'"
                        },
                        {
                          "name": "dataId",
                          "type": "String",
                          "description": "데이터 ID입니다. 예: 'data_1'"
                        },
                        {
                          "name": "index",
