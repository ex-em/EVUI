{
  "name": "evui",
  "version": "4.0.0-10",
  "author": "exem <dev_client@ex-em.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run type-check && pnpm run build:global-type && vite build",
    "build:type": "vue-tsc --declaration --emitDeclarationOnly",
    "build:global-type": "tsx ./scripts/buildGlobalType.ts",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "lint:style": "stylelint --fix **/*.{css,scss,sass,vue,html}",
    "prettier": "prettier --write .",
    "clean": "rm -rf dist"
  },
  "type": "module",
  "files": [
    "dist",
    "global.d.ts"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./style": {
      "import": "./dist/style.css",
      "require": "./dist/style.css"
    },
    "./global": {
      "types": "./global.d.ts"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/tsconfig": "^0.9.1",
    "glob": "^14.0.6",
    "sass": "^1.108.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vue": "^3.5.45",
    "vue-tsc": "~3.2.9",
    "@types/lodash": "^4.17.27",
    "@vue/language-core": "~3.2.9"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "bignumber.js": "^9.3.1",
    "dayjs": "^1.11.23",
    "korean-regexp": "^1.0.13",
    "lodash-es": "^4.18.1",
    "vue-resize-observer": "^2.0.16",
    "vue3-observe-visibility": "^1.0.7"
  }
}
